{
  // The browser half. Separate from the Worker's config so each gets the right
  // global types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `google.maps` is types only — the SDK itself arrives as a script tag at
    // runtime (app/lib/googleMaps.ts), so nothing is bundled from it.
    "types": ["vite/client", "google.maps"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The deferred() test renders a component module on the server; it lives
  // with the other unit tests but needs this config's DOM lib (tsconfig.json
  // `exclude` says why).
  "include": ["app", "tests/unit/deferred.test.ts"]
}
