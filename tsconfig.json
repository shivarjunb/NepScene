{
  // Worker + tests. Deliberately no DOM lib: the Workers runtime types and the
  // DOM's differ (CacheStorage most visibly), and mixing them hides real errors.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["api", "tests"],
  // Browser specs have their own config; they need DOM types this one forbids.
  "exclude": ["tests/e2e"]
}
