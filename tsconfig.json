{
  // Worker + tests. Deliberately no DOM lib: the Workers runtime types and the
  // DOM's differ (CacheStorage most visibly), and mixing them hides real errors.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // The Worker server-renders the same React components the browser does
    // (#45), so it compiles JSX — but still without the DOM lib, which is what
    // keeps a component that reaches for `window` from compiling here.
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The server renderer is browser code — React components that reach for
    // `document` inside effects — and typechecking it here would need the DOM
    // lib, which conflicts with the Workers types (see below). So the Worker
    // imports it through a declared boundary instead: TypeScript resolves
    // `#ssr` to a hand-written contract, and wrangler's esbuild resolves it to
    // the real module (wrangler.jsonc `alias`). The components stay typechecked
    // by tsconfig.app.json, where the DOM lib belongs.
    "paths": { "#ssr": ["./api/render/ssr.d.ts"] },
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["api", "tests"],
  // Browser specs have their own config; they need DOM types this one forbids.
  // So does the one unit test of a component module: `deferred()` renders an
  // `Alert` when its chunk fails to arrive, and that import reaches the rest
  // of the primitives, whose effects touch `document`. It is typechecked by
  // tsconfig.app.json instead, where the DOM lib belongs, and still runs in
  // workerd with the rest (vitest.config.ts `include`).
  "exclude": ["tests/e2e", "tests/unit/deferred.test.ts"]
}
