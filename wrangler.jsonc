{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nepscene",
  "main": "api/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // `#ssr` is the seam between the Worker and the browser components it
  // server-renders (#45). Three resolvers point at it and none of them can be
  // the same thing:
  //   - TypeScript      → api/render/ssr.d.ts, so the app's DOM types never
  //                       reach the Worker's config
  //   - wrangler (here) → the *built* renderer, because wrangler forces
  //                       esbuild's classic JSX factory and the components
  //                       have no `React` binding for it to call
  //   - vitest          → app/server.tsx directly, since Vite compiles JSX
  // `npm run build` produces dist/ssr/server.js; a deploy without it renders
  // nothing and falls back to the plain shell.
  "alias": { "#ssr": "./dist/ssr/server.js" },

  // The Worker answers /api/* and the pages it server-renders (#45);
  // everything else is served straight from the edge, and anything that
  // matches no file falls back to index.html.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/listings/*",
      "/venues",
      "/venues/*",
      "/organizers",
      "/organizers/*",
      "/artists/*",
      "/search",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemaps/*"
    ]
  },

  "observability": { "enabled": true },

  // Auto-archive (#33). 18:15 UTC is midnight in Kathmandu (UTC+5:45) — the
  // sweep runs at the quietest hour for the audience it serves, not for the
  // colo it happens to run in. `triggers` is not inherited by environments,
  // so each one repeats it; an environment that omitted it would silently
  // never archive anything.
  "triggers": { "crons": ["15 18 * * *"] },

  // D1 read replication is enabled per-database in the Cloudflare dashboard;
  // the Worker opts into replica reads with withSession() (see api/lib/d1.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nepscene-local",
      "database_id": "00000000-0000-0000-0000-000000000000" // replaced per environment below
    }
  ],

  "kv_namespaces": [
    { "binding": "SETTINGS", "id": "0000000000000000000000000000local" }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "nepscene-media-local" }
  ],

  "vars": {
    "ENVIRONMENT": "local",
    // Set per environment. Empty means offers are not resolved and listings
    // render without them — discovery never depends on commerce being up.
    "OFFER_API_URL": "",
    // GOOGLE_CLIENT_SECRET is a secret: `wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_CLIENT_ID": ""
  },

  "env": {
    "preview": {
      "name": "nepscene-preview",
      "triggers": { "crons": ["15 18 * * *"] },
      "vars": { "ENVIRONMENT": "preview", "OFFER_API_URL": "", "GOOGLE_CLIENT_ID": "" },
      "d1_databases": [
        { "binding": "DB", "database_name": "nepscene-preview", "database_id": "7fdabb69-3ba6-4cf8-b491-c52dca02c881" }
      ],
      "kv_namespaces": [{ "binding": "SETTINGS", "id": "d80811fb98494352a5fb7970c651f8bd" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nepscene-media-preview" }]
    },
    "staging": {
      "name": "nepscene-staging",
      "triggers": { "crons": ["15 18 * * *"] },
      "vars": { "ENVIRONMENT": "staging", "OFFER_API_URL": "", "GOOGLE_CLIENT_ID": "" },
      "d1_databases": [
        { "binding": "DB", "database_name": "nepscene-staging", "database_id": "464a0115-82e2-4c84-9acb-23cbe9fc041c" }
      ],
      "kv_namespaces": [{ "binding": "SETTINGS", "id": "4b8f67127a8d4c9fb0e1f55792dd3ea4" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nepscene-media-staging" }]
    },
    "production": {
      "name": "nepscene",
      "triggers": { "crons": ["15 18 * * *"] },
      "vars": { "ENVIRONMENT": "production", "OFFER_API_URL": "", "GOOGLE_CLIENT_ID": "" },
      "d1_databases": [
        { "binding": "DB", "database_name": "nepscene-production", "database_id": "63c61f55-3138-44d8-8226-05330926231e" }
      ],
      "kv_namespaces": [{ "binding": "SETTINGS", "id": "4cac4a48472a43109a1079fbd6724652" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nepscene-media-production" }]
    }
  }
}
