{
  "name": "nepscene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape:all": "node scripts/scrape-all.mjs",
    "dev": "wrangler dev",
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply nepscene-local --local",
    "db:drift": "node scripts/check-schema-drift.mjs",
    "db:seed": "wrangler d1 execute nepscene-local --local --file=./scripts/seed-demo-catalogue.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "test:coverage": "vitest run --coverage",
    "db:verify": "node scripts/verify-catalogue.mjs",
    "db:volume": "node scripts/seed-volume.mjs --count 10000",
    "db:import": "node scripts/import-waahtickets.mjs",
    "db:admin": "node scripts/create-admin.mjs",
    "test:e2e": "playwright test",
    "brand": "node scripts/generate-brand-assets.mjs",
    "budget": "node scripts/check-budget.mjs",
    "ci:guards": "node scripts/check-migrations.mjs && node scripts/check-scope.mjs && node scripts/check-secrets.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
