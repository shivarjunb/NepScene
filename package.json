{
  "name": "nepscene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply nepscene-local --local",
    "db:seed": "wrangler d1 execute nepscene-local --local --file=./scripts/seed-demo-catalogue.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "test:coverage": "vitest run --coverage",
    "db:verify": "node scripts/verify-catalogue.mjs",
    "db:volume": "node scripts/seed-volume.mjs --count 10000",
    "db:import": "node scripts/import-waahtickets.mjs"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  }
}
